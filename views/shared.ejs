<% title='Shared calendar' %>
<section class="ediary-page-heading"><div><p class="ediary-eyebrow">SHARED DIARY</p><h1>Appointments</h1><p>What you see depends on the owner�s access setting.</p></div></section>
<form class="ediary-date-filter mb-3"><label class="ediary-field-label" for="shared-from">From</label><input id="shared-from" class="form-control" type="date" name="from" value="<%= from %>"><label class="ediary-field-label" for="shared-to">To</label><input id="shared-to" class="form-control" type="date" name="to" value="<%= to %>"><button class="btn btn-primary">Filter</button></form>
<section class="ediary-panel ediary-agenda"><% rows.forEach(row=>{ %><article class="ediary-agenda__row"><time class="ediary-agenda__time"><%= row.appointmentTime.slice(0,5) %></time><div><h2 class="ediary-agenda__title"><%= row.title||'Busy' %></h2><div class="ediary-agenda__meta"><%= row.appointmentDate %><% if(row.title&&row.location){ %> � <%= row.location %><% } %><% if(row.title&&row.contactName){ %> � <%= row.contactName %><% } %><% if(row.title&&row.notes){ %><br><%= row.notes %><% } %></div></div><span class="ediary-agenda__date"><%= row.availability||'' %></span></article><% }) %><% if(!rows.length){ %><div class="ediary-empty">No appointments in this date range.</div><% } %></section>
